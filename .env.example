# Local credentials only; .env is git-ignored. Restart the app after changes.
# auto: choose Gemini, then Groq, then Anthropic if a corresponding key is set;
# otherwise use validated templates. offline: force templates without API calls.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# GEMINI_MODELS=your-supported-model-id
# GROQ_MODELS=your-supported-model-id
# LLM_MODEL=your-supported-anthropic-model-id
# LLM_CACHE_DIR=data/llm_cache
